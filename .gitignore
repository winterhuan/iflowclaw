# Dependencies
node_modules/

# Build output
dist/

# Environment
.env
.env.local
*.local.json

# Data
store/
data/
logs/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Generated files
iflowclaw.service

# Test
coverage/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
*.egg-info/

# TypeScript
tsconfig.tsbuildinfo

# iFlow CLI config - keep skills but ignore other state
.iflow/*
!.iflow/skills/
**/.iflow/*
!**/.iflow/skills/

# Groups - keep AGENTS.md, .iflow/, and claude-mem-iflow/, ignore everything else
# First ignore all content in group directories
groups/*/*
# Then exclude what we want to keep
!groups/*/AGENTS.md
!groups/*/.iflow
!groups/*/.iflow/**
!groups/*/claude-mem-iflow
!groups/*/claude-mem-iflow/**

# Exception: main group .iflow should not be committed
groups/main/.iflow/

# Vendor dependencies
_vendor/nanoclaw/
