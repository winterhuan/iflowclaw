# iFlowClaw Configuration
# Copy this file to .env and fill in your values

# Assistant name (used for @mentions)
ASSISTANT_NAME=iFlow

# ===========================================
# Feishu (Lark) Channel Configuration
# ===========================================
# Get your credentials from: https://open.feishu.cn/app
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# Agent Backend Configuration
# ===========================================
# Backend: "iflow" or "claude"
AGENT_BACKEND=iflow

# ===========================================
# iFlow Backend (OpenAI Compatible API)
# ===========================================
# iFlow uses OpenAI-compatible API
OPENAI_API_KEY=your-iflow-api-key
OPENAI_BASE_URL=https://api.iflow.ai/v1
IFLOW_MODEL=gpt-4o

# ===========================================
# Claude Backend (Optional)
# ===========================================
# ANTHROPIC_API_KEY=sk-ant-xxx
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ===========================================
# Agent Configuration
# ===========================================
AGENT_TIMEOUT=300000
IDLE_TIMEOUT=180000
MAX_CONCURRENT_AGENTS=5

# ===========================================
# Execution Mode
# ===========================================
# Default execution mode: "direct" or "container"
DEFAULT_EXECUTION_MODE=direct

# ===========================================
# Timezone & Logging
# ===========================================
TZ=Asia/Shanghai
LOG_LEVEL=info
