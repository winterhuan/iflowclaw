# iFlowClaw Configuration
# Copy this file to .env and fill in your values

# Assistant name (used for @mentions)
ASSISTANT_NAME=iFlow

# ===========================================
# Feishu (Lark) Channel Configuration
# ===========================================
# Get your credentials from: https://open.feishu.cn/app
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# Authentication
# ===========================================

# iFlow CLI OAuth Login (REQUIRED)
# Run `iflow login` to authenticate. The SDK will automatically use
# credentials from ~/.iflow/settings.json. No configuration needed here!

# ===========================================
# Agent Configuration
# ===========================================
AGENT_TIMEOUT=1800000
IDLE_TIMEOUT=1800000
MAX_CONCURRENT_AGENTS=5

# ===========================================
# Container Execution Mode
# ===========================================
# Default execution mode: "direct" or "container"
# Main group always uses "direct" regardless of this setting.
# Non-main groups use this setting (default: "container")
DEFAULT_EXECUTION_MODE=container

# Container image name
CONTAINER_IMAGE=iflowclaw-agent:latest

# Container hard timeout (ms) - must be >= IDLE_TIMEOUT + 30000
CONTAINER_TIMEOUT=1800000

# Credential proxy port (host-side HTTP proxy that injects API keys)
CREDENTIAL_PROXY_PORT=3001

# Logging
LOG_LEVEL=info
# ===========================================
# Embedding Configuration (for semantic memory)
# ===========================================
# Get your API key from: https://build.nvidia.com/explore/embedding
EMBEDDING_API_KEY=your-nvidia-api-key-here
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=baai/bge-m3
